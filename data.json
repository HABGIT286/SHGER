        "martyrdom": "استشهد في كربلاء يوم عاشوراء 10 محرم 61 هـ، بعد أن قتل من أصحابه وأهل بيته 72 نفساً، وقُتل هو غيلة على يد شمر بن ذي الجوشن.",
        "burial": "دُفن رأسه الشريف في الجامع الأموي بدمشق ثم نُقل إلى كربلاء، وجسده الطاهر في المرقد الحسيني في كربلاء المقدسة."
      },
      "narrations": {
        "hadiths": [
          "إنما خرجت لطلب الإصلاح في أمة جدي، آمر بالمعروف وأنهى عن المنكر.",
          "لا قوة إلا بالله، ما ندم من استخار، وما خاب من استشار.",
          "الناس عبيد الدنيا، والدين لعق على ألسنتهم يحوطونه ما درّت معايشهم."
        ],
        "sayings": [
          "هيهات منّا الذلة، يأبى الله لنا ذلك ورسوله والمؤمنون.",
          "إن لم يكن لك دين، وكنتم لا تخافون المعاد، فكونوا أحراراً في دنياكم.",
          "الموت سنام المؤمن."
        ],
        "wills": [
          "أوصيكم بتقوى الله، وألا تطلبوا الدنيا وإن طلبتكم.",
          "إني تارك فيكم كتاب الله وسنة جدي وأبي وأخي."
        ],
        "prayers": [
          "دعاء يوم عرفة للإمام الحسين (ع): 'يا من أنارت بنوره ظلم كل ظلمة...'",
          "دعاء يوم عاشوراء: 'إلهي رضاً بقضائك، وتسليماً لأمرِك...'"
        ],
        "visits": [
          "الزيارة الجامعة الكبيرة",
